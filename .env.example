# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional: Discord ─────────────────────────────────────────────────────────
# Prefix for legacy text commands (default: !)
COMMAND_PREFIX=!

# Bot presence status shown in Discord
BOT_STATUS=D&D 5e | !help

# Guild ID to sync slash commands instantly during development (leave blank for global sync)
TEST_GUILD_ID=

# ── Optional: OpenAI ──────────────────────────────────────────────────────────
# Model to use for AI DM (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Override the API base URL (e.g. for Azure OpenAI or a local proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# Max tokens for scene/narration generation (default: 2000)
AI_MAX_TOKENS_SCENE=2000

# Max tokens for NPC dialogue generation (default: 1000)
AI_MAX_TOKENS_TALK=1000
